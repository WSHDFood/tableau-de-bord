# Copiez ce fichier sous le nom « .env » pour lancer la collecte depuis votre ordinateur.
# En ligne, ces mêmes noms sont à créer dans GitHub : Settings > Secrets and variables > Actions.
# Ne publiez jamais le fichier .env : il est déjà exclu par .gitignore.

# Mot de passe du tableau de bord (une phrase d'au moins quatre mots).
DASHBOARD_PASSWORD=

# Google Search Console : chemin du fichier de clé du compte de service…
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/cle-google.json
# … ou, en ligne, son contenu complet dans GOOGLE_SERVICE_ACCOUNT_JSON.

# Meta (Instagram et Facebook) : jeton de l'utilisateur système.
META_ACCESS_TOKEN=

# LinkedIn : jeton d'accès. Identifiant et secret de l'application : facultatifs,
# ils servent à afficher la date d'expiration. Jeton de renouvellement : si LinkedIn en fournit un.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
